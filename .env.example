# Configuration — copy to .env and fill in.
# NEVER commit the real .env; it holds live credentials.

# ── Telegram (required) ───────────────────────────────────────────────
BOT_TOKEN=123456:your-bot-token-from-BotFather
BOT_USERNAME=YourBot
ADMIN_IDS=123456789

# ── Runtime paths (host-specific) ─────────────────────────────────────
# run.sh reads VENV/NODE/POT_DIR/POT_PORT from here so unattended starts
# (cron, @reboot) pick up the right locations.
VENV=/opt/botvenv
NODE=/opt/node22/bin/node
POT_DIR=/opt/bgutil-pot/server
POT_PORT=4416

# ── Web dashboard ─────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_PASSWORD=change-me

# ── Behaviour (optional; defaults shown) ──────────────────────────────
GROUP_AUTO_DOWNLOAD=0
BEST_MAX_HEIGHT=1080

# iOS playback compatibility (see bot/utils/media_handler.ensure_ios_compatible)
IOS_COMPAT=1
IOS_COMPAT_MAX_DURATION=1800
IOS_COMPAT_THREADS=4
